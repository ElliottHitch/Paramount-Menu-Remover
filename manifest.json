{
  "manifest_version": 3,
  "name": "Paramount Menu Remover",
  "version": "1.0.0",
  "description": "Removes on-screen overlay/menu elements from Paramount+ playback pages.",
  "content_scripts": [
    {
      "matches": [
        "*://www.paramountplus.com/*",
        "*://paramountplus.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
